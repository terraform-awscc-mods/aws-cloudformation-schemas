{
  "tagging" : {
    "permissions" : [ "gamelift:ListTagsForResource", "gamelift:TagResource", "gamelift:UntagResource" ],
    "taggable" : true,
    "tagOnCreate" : true,
    "tagUpdatable" : true,
    "tagProperty" : "/properties/Tags",
    "cloudFormationSystemTags" : true
  },
  "$schema" : "https://schema.cloudformation.us-east-1.amazonaws.com/provider.definition.schema.v1.json",
  "typeName" : "AWS::GameLift::GameSessionQueue",
  "readOnlyProperties" : [ "/properties/Arn" ],
  "description" : "The AWS::GameLift::GameSessionQueue resource creates an Amazon GameLift (GameLift) game session queue.",
  "createOnlyProperties" : [ "/properties/Name" ],
  "primaryIdentifier" : [ "/properties/Name" ],
  "required" : [ "Name" ],
  "sourceUrl" : "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-gamelift.git",
  "handlers" : {
    "read" : {
      "permissions" : [ "gamelift:DescribeGameSessionQueues", "gamelift:ListTagsForResource" ]
    },
    "create" : {
      "permissions" : [ "gamelift:AllowVendedLogDeliveryForResource", "gamelift:CreateGameSessionQueue", "gamelift:DescribeGameSessionQueues", "gamelift:ListTagsForResource", "gamelift:TagResource", "logs:PutDeliverySource", "logs:PutDeliveryDestination", "logs:CreateDelivery", "logs:CreateLogGroup", "logs:DescribeLogGroups", "logs:DescribeResourcePolicies", "logs:PutResourcePolicy", "s3:CreateBucket", "s3:GetBucketPolicy", "s3:PutBucketPolicy", "firehose:TagDeliveryStream", "iam:CreateServiceLinkedRole" ]
    },
    "update" : {
      "permissions" : [ "gamelift:AllowVendedLogDeliveryForResource", "gamelift:UpdateGameSessionQueue", "gamelift:ListTagsForResource", "gamelift:TagResource", "gamelift:UntagResource", "gamelift:DescribeGameSessionQueues", "logs:PutDeliverySource", "logs:PutDeliveryDestination", "logs:CreateDelivery", "logs:CreateLogGroup", "logs:DeleteDelivery", "logs:DeleteDeliveryDestination", "logs:DeleteDeliverySource", "logs:DescribeLogGroups", "logs:DescribeResourcePolicies", "logs:PutResourcePolicy", "s3:CreateBucket", "s3:GetBucketPolicy", "s3:PutBucketPolicy", "firehose:TagDeliveryStream", "iam:CreateServiceLinkedRole" ]
    },
    "list" : {
      "permissions" : [ "gamelift:DescribeGameSessionQueues" ]
    },
    "delete" : {
      "permissions" : [ "gamelift:DescribeGameSessionQueues", "gamelift:DeleteGameSessionQueue", "logs:DeleteDelivery", "logs:DeleteDeliveryDestination", "logs:DeleteDeliverySource" ]
    }
  },
  "additionalProperties" : false,
  "definitions" : {
    "PlayerLatencyPolicy" : {
      "description" : "Sets a latency cap for individual players when placing a game session.",
      "additionalProperties" : false,
      "type" : "object",
      "properties" : {
        "PolicyDurationSeconds" : {
          "description" : "The length of time, in seconds, that the policy is enforced while placing a new game session.",
          "type" : "integer",
          "minimum" : 0
        },
        "MaximumIndividualPlayerLatencyMilliseconds" : {
          "description" : "The maximum latency value that is allowed for any player, in milliseconds. All policies must have a value set for this property.",
          "type" : "integer",
          "minimum" : 0
        }
      }
    },
    "AllowedLocations" : {
      "minItems" : 1,
      "maxItems" : 100,
      "description" : "A list of locations to allow game session placement in, in the form of AWS Region codes such as us-west-2.",
      "insertionOrder" : false,
      "type" : "array",
      "items" : {
        "minLength" : 1,
        "pattern" : "^[a-z]+(-([a-z]+|\\d))*",
        "type" : "string",
        "maxLength" : 64
      }
    },
    "FilterConfiguration" : {
      "additionalProperties" : false,
      "type" : "object",
      "properties" : {
        "AllowedLocations" : {
          "$ref" : "#/definitions/AllowedLocations"
        }
      }
    },
    "PriorityOrder" : {
      "minItems" : 1,
      "maxItems" : 4,
      "description" : "The recommended sequence to use when prioritizing where to place new game sessions.",
      "insertionOrder" : true,
      "type" : "array",
      "items" : {
        "type" : "string",
        "enum" : [ "LATENCY", "COST", "DESTINATION", "LOCATION" ]
      }
    },
    "GameSessionQueueDestination" : {
      "description" : "A fleet or alias designated in a game session queue.",
      "additionalProperties" : false,
      "type" : "object",
      "properties" : {
        "DestinationArn" : {
          "minLength" : 1,
          "pattern" : "[a-zA-Z0-9:/-]+",
          "type" : "string",
          "maxLength" : 256
        }
      }
    },
    "Tag" : {
      "description" : "A key-value pair to associate with a resource.",
      "additionalProperties" : false,
      "type" : "object",
      "properties" : {
        "Value" : {
          "minLength" : 1,
          "description" : "The value for the tag. You can specify a value that is 1 to 256 Unicode characters in length.",
          "type" : "string",
          "maxLength" : 256
        },
        "Key" : {
          "minLength" : 1,
          "description" : "The key name of the tag. You can specify a value that is 1 to 128 Unicode characters in length.",
          "type" : "string",
          "maxLength" : 128
        }
      },
      "required" : [ "Key", "Value" ]
    },
    "LocationOrder" : {
      "minItems" : 1,
      "maxItems" : 100,
      "description" : "The prioritization order to use for fleet locations, when the PriorityOrder property includes LOCATION.",
      "insertionOrder" : true,
      "type" : "array",
      "items" : {
        "minLength" : 1,
        "pattern" : "^[A-Za-z0-9\\-]+",
        "type" : "string",
        "maxLength" : 64
      }
    },
    "PriorityConfiguration" : {
      "additionalProperties" : false,
      "type" : "object",
      "properties" : {
        "PriorityOrder" : {
          "$ref" : "#/definitions/PriorityOrder"
        },
        "LocationOrder" : {
          "$ref" : "#/definitions/LocationOrder"
        }
      }
    }
  },
  "properties" : {
    "TimeoutInSeconds" : {
      "description" : "The maximum time, in seconds, that a new game session placement request remains in the queue.",
      "type" : "integer",
      "minimum" : 0
    },
    "PlayerLatencyPolicies" : {
      "description" : "A set of policies that act as a sliding cap on player latency.",
      "insertionOrder" : false,
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/PlayerLatencyPolicy"
      }
    },
    "Destinations" : {
      "description" : "A list of fleets and/or fleet aliases that can be used to fulfill game session placement requests in the queue.",
      "insertionOrder" : true,
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/GameSessionQueueDestination"
      }
    },
    "NotificationTarget" : {
      "minLength" : 1,
      "pattern" : "[a-zA-Z0-9:_-]*(\\.fifo)?",
      "description" : "An SNS topic ARN that is set up to receive game session placement notifications.",
      "type" : "string",
      "maxLength" : 300
    },
    "FilterConfiguration" : {
      "description" : "A list of locations where a queue is allowed to place new game sessions.",
      "type" : "object",
      "$ref" : "#/definitions/FilterConfiguration"
    },
    "Arn" : {
      "minLength" : 1,
      "pattern" : "^arn:.*:gamesessionqueue\\/[a-zA-Z0-9-]+",
      "description" : "The Amazon Resource Name (ARN) that is assigned to a Amazon GameLift game session queue resource and uniquely identifies it.",
      "type" : "string",
      "maxLength" : 256
    },
    "CustomEventData" : {
      "minLength" : 1,
      "pattern" : "[\\s\\S]*",
      "description" : "Information that is added to all events that are related to this game session queue.",
      "type" : "string",
      "maxLength" : 256
    },
    "Tags" : {
      "maxItems" : 200,
      "uniqueItems" : true,
      "description" : "An array of key-value pairs to apply to this resource.",
      "insertionOrder" : false,
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/Tag"
      }
    },
    "Name" : {
      "minLength" : 1,
      "pattern" : "[a-zA-Z0-9-]+",
      "description" : "A descriptive label that is associated with game session queue. Queue names must be unique within each Region.",
      "type" : "string",
      "maxLength" : 128
    },
    "PriorityConfiguration" : {
      "description" : "Custom settings to use when prioritizing destinations and locations for game session placements.",
      "type" : "object",
      "$ref" : "#/definitions/PriorityConfiguration"
    }
  }
}