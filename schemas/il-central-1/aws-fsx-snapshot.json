{
  "sourceUrl" : "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "tagging" : {
    "permissions" : [ "fsx:TagResource", "fsx:UntagResource", "fsx:ListTagsForResource" ],
    "taggable" : true,
    "tagOnCreate" : true,
    "tagUpdatable" : true,
    "tagProperty" : "/properties/Tags",
    "cloudFormationSystemTags" : true
  },
  "handlers" : {
    "read" : {
      "permissions" : [ "fsx:DescribeSnapshots", "fsx:ListTagsForResource" ]
    },
    "create" : {
      "permissions" : [ "fsx:CreateSnapshot", "fsx:TagResource", "fsx:DescribeSnapshots" ],
      "timeoutInMinutes" : 490
    },
    "update" : {
      "permissions" : [ "fsx:UpdateSnapshot", "fsx:TagResource", "fsx:UntagResource", "fsx:DescribeSnapshots" ],
      "timeoutInMinutes" : 490
    },
    "list" : {
      "permissions" : [ "fsx:DescribeSnapshots" ]
    },
    "delete" : {
      "permissions" : [ "fsx:DeleteSnapshot", "fsx:DescribeSnapshots" ],
      "timeoutInMinutes" : 70
    }
  },
  "typeName" : "AWS::FSx::Snapshot",
  "readOnlyProperties" : [ "/properties/ResourceARN", "/properties/Id" ],
  "description" : "Resource Type definition for AWS::FSx::Snapshot",
  "createOnlyProperties" : [ "/properties/VolumeId" ],
  "additionalProperties" : false,
  "primaryIdentifier" : [ "/properties/Id" ],
  "definitions" : {
    "Tag" : {
      "additionalProperties" : false,
      "type" : "object",
      "properties" : {
        "Value" : {
          "description" : "A value that specifies the TagValue, the value assigned to the corresponding tag key. Tag values can be null and don't have to be unique in a tag set. For example, you can have a key-value pair in a tag set of finances : April and also of payroll : April.",
          "type" : "string"
        },
        "Key" : {
          "description" : "A value that specifies the TagKey, the name of the tag. Tag keys must be unique for the resource to which they are attached.",
          "type" : "string"
        }
      },
      "required" : [ "Value", "Key" ]
    }
  },
  "required" : [ "VolumeId", "Name" ],
  "properties" : {
    "ResourceARN" : {
      "description" : "Returns the snapshot's Amazon Resource Name (ARN).",
      "type" : "string"
    },
    "VolumeId" : {
      "description" : "The ID of the volume that the snapshot is of.",
      "type" : "string"
    },
    "Id" : {
      "description" : "The ID of the snapshot.",
      "type" : "string"
    },
    "Tags" : {
      "uniqueItems" : false,
      "description" : "A list of Tag values, with a maximum of 50 elements.",
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/Tag"
      }
    },
    "Name" : {
      "description" : "The name of the snapshot.",
      "type" : "string"
    }
  }
}