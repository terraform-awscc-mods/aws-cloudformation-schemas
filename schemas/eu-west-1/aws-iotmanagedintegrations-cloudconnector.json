{
  "typeName" : "AWS::IoTManagedIntegrations::CloudConnector",
  "description" : "Resource type definition for AWS::IoTManagedIntegrations::CloudConnector. A cloud connector (C2C connector) points at an AWS Lambda endpoint that implements the managed integrations cloud-to-cloud connector contract, enabling discovery and control of third-party cloud devices.",
  "definitions" : {
    "LambdaConfig" : {
      "type" : "object",
      "description" : "Configuration details for an AWS Lambda function used as an endpoint for a cloud connector.",
      "properties" : {
        "Arn" : {
          "type" : "string",
          "description" : "The Amazon Resource Name (ARN) of the Lambda function used as an endpoint.",
          "pattern" : "^(arn:aws:lambda:[0-9a-zA-Z-]+:[0-9]+:function:)?([a-zA-Z0-9-_]+(:(\\$LATEST|[a-zA-Z0-9-_]+))?)$"
        }
      },
      "required" : [ "Arn" ],
      "additionalProperties" : false
    },
    "EndpointConfig" : {
      "type" : "object",
      "description" : "The configuration details for the cloud connector endpoint, including connection parameters and authentication requirements.",
      "properties" : {
        "Lambda" : {
          "$ref" : "#/definitions/LambdaConfig"
        }
      },
      "additionalProperties" : false
    }
  },
  "properties" : {
    "Arn" : {
      "type" : "string",
      "description" : "The Amazon Resource Name (ARN) of the cloud connector.",
      "minLength" : 63,
      "maxLength" : 1011,
      "pattern" : "^arn:aws:iotmanagedintegrations:[0-9a-zA-Z-]+:[0-9]+:cloud-connector/[A-Za-z0-9_-]+$"
    },
    "Id" : {
      "type" : "string",
      "description" : "The unique identifier of the cloud connector.",
      "minLength" : 1,
      "maxLength" : 64,
      "pattern" : "^[A-Za-z0-9-_]+$"
    },
    "Name" : {
      "type" : "string",
      "description" : "The display name of the C2C connector.",
      "minLength" : 1,
      "maxLength" : 128,
      "pattern" : "^[A-Za-z0-9-_ ]+$"
    },
    "Description" : {
      "type" : "string",
      "description" : "A description of the C2C connector.",
      "minLength" : 1,
      "maxLength" : 256,
      "pattern" : "^[0-9A-Za-z_\\- ]+$"
    },
    "EndpointType" : {
      "type" : "string",
      "description" : "The type of endpoint used for the cloud connector, which defines how the connector communicates with external services.",
      "enum" : [ "LAMBDA" ]
    },
    "EndpointConfig" : {
      "$ref" : "#/definitions/EndpointConfig"
    },
    "Type" : {
      "type" : "string",
      "description" : "The type of cloud connector.",
      "enum" : [ "LISTED", "UNLISTED" ]
    }
  },
  "required" : [ "Name", "EndpointConfig" ],
  "additionalProperties" : false,
  "readOnlyProperties" : [ "/properties/Arn", "/properties/Id", "/properties/Type" ],
  "createOnlyProperties" : [ "/properties/EndpointConfig", "/properties/EndpointType" ],
  "primaryIdentifier" : [ "/properties/Arn" ],
  "additionalIdentifiers" : [ [ "/properties/Id" ] ],
  "tagging" : {
    "taggable" : false
  },
  "handlers" : {
    "create" : {
      "permissions" : [ "iotmanagedintegrations:CreateCloudConnector", "lambda:InvokeFunction" ]
    },
    "read" : {
      "permissions" : [ "iotmanagedintegrations:GetCloudConnector" ]
    },
    "update" : {
      "permissions" : [ "iotmanagedintegrations:UpdateCloudConnector" ]
    },
    "delete" : {
      "permissions" : [ "iotmanagedintegrations:DeleteCloudConnector", "iotmanagedintegrations:GetCloudConnector" ]
    },
    "list" : {
      "permissions" : [ "iotmanagedintegrations:ListCloudConnectors" ]
    }
  }
}