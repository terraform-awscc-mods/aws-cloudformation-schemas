          "minLength" : 1,
          "maxLength" : 255,
          "pattern" : "^arn:(aws|aws-cn|aws-us-gov):iam::\\d{12}:role/[a-zA-Z0-9+=,.@_/-]+$"
        }
      },
      "required" : [ "PrivateConnectionName", "RuntimeRoleArn" ],
      "additionalProperties" : false
    },
    "SourceAwsConfiguration" : {
      "description" : "AWS association for 'source' account",
