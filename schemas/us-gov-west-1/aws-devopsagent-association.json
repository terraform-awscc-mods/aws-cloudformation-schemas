      "properties" : {
        "Name" : {
          "description" : "The name for this release management environment",
          "type" : "string",
          "minLength" : 1,
          "maxLength" : 128,
          "pattern" : "^[\\p{L}\\p{N}\\p{P}\\p{S}\\p{Z}]+$"
        },
        "NetworkAccess" : {
          "description" : "Specifies how AWS DevOps Agent reaches your application using this release management environment",
          "$ref" : "#/definitions/NetworkAccessConfiguration"
        }
      },
      "required" : [ "Name", "NetworkAccess" ],
      "additionalProperties" : false
    },
    "NetworkAccessConfiguration" : {
      "description" : "Specifies how AWS DevOps Agent reaches your application using a release management environment. Exactly one access type must be specified.",
      "type" : "object",
